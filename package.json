{
  "name": "agent-commerce-middleman",
  "version": "1.0.0",
  "description": "Deterministic Guardrails, Policy Engine, and Razorpay Payment Gateway for Autonomous AI Agents",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "node apps/api/src/index.js",
    "api:dev": "node apps/api/src/index.js",
    "dev:dashboard": "npm run dev --workspace=dashboard",
    "dashboard:dev": "npm run dev --workspace=dashboard",
    "mcp:start": "node apps/mcp-server/src/index.js",
    "api:test-order": "node apps/api/test-order.js",
    "test": "node --test packages/policy-engine/src/rules.test.js",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=packages/db/prisma/schema.prisma",
    "db:seed": "node packages/db/prisma/seed.js",
    "db:studio": "prisma studio --schema=packages/db/prisma/schema.prisma"
  },
  "keywords": [
    "ai-agents",
    "mcp",
    "razorpay",
    "policy-engine",
    "guardrails",
    "payments"
  ],
  "author": "Shikharyadav25",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fastify-raw-body": "^6.0.1",
    "pino": "^10.3.1",
    "prisma": "^6.19.3",
    "razorpay": "^2.9.8",
    "zod": "^4.5.4"
  }
}
